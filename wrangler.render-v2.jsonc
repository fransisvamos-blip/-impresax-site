{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "impresax-render-v2-shadow",
  "main": "src/render-v2/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "upload_source_maps": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "RENDER_ARTIFACTS", "bucket_name": "impresax-render-v2-shadow" }
  ],
  "workflows": [
    {
      "name": "impresax-render-v2-prospect",
      "binding": "RENDER_PROSPECT_WORKFLOW",
      "class_name": "RenderProspectWorkflow"
    },
    {
      "name": "impresax-render-v2-variant",
      "binding": "RENDER_VARIANT_WORKFLOW",
      "class_name": "RenderVariantWorkflow"
    },
    {
      "name": "impresax-render-v2-chaos",
      "binding": "RENDER_CHAOS_WORKFLOW",
      "class_name": "RenderChaosProbeWorkflow"
    },
    {
      "name": "impresax-render-v2-input-remediation",
      "binding": "RENDER_INPUT_REMEDIATION_WORKFLOW",
      "class_name": "RenderInputRemediationWorkflow"
    }
  ],
  "vars": {
    "V2_MODEL_CREATIVE": "@cf/moonshotai/kimi-k2.7-code",
    "V2_MODEL_VARIANT_GENERATOR": "@cf/zai-org/glm-4.7-flash",
    "V2_MODEL_VARIANT_REPAIR": "@cf/moonshotai/kimi-k2.7-code",
    "V2_MODEL_CODE_FALLBACK": "@cf/moonshotai/kimi-k2.7-code",
    "V2_MODEL_VISUAL_QA": "@cf/qwen/qwen3.8-27b",
    "V2_MODEL_SET_QA": "@cf/qwen/qwen3.8-27b",
    "V2_MODEL_TEXT_FALLBACK": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "V2_MODEL_VISION_FALLBACK": "@cf/moonshotai/kimi-k2.7-code",
    "V2_MODEL_HERO_IMAGE": "@cf/black-forest-labs/flux-2-dev",
    "V2_MODEL_HERO_IMAGE_FALLBACK": "@cf/black-forest-labs/flux-2-klein-9b",
    "V2_MAX_AI_CALLS_PER_PACK": "90",
    "V2_MAX_BROWSER_CAPTURES_PER_PACK": "18",
    "V2_SHADOW_AUTOSTART": "CZ-063"
  }
}
