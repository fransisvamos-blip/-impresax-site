{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiet-salad-5340",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "impresax.org",
      "custom_domain": true
    },
    {
      "pattern": "www.impresax.org",
      "custom_domain": true
    },
    {
      "pattern": "*.impresax.org/*",
      "zone_name": "impresax.org"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "keep_vars": true
}
