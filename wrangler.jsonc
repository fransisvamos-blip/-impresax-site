{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiet-salad-5340",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "impresax.org",
      "custom_domain": true
    },
    {
      "pattern": "www.impresax.org",
      "custom_domain": true
    },
    {
      "pattern": "*.impresax.org/*",
      "zone_name": "impresax.org"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "keep_vars": true,
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "info@impresax.org"
      ]
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "RENDER_ARTIFACTS",
      "bucket_name": "impresax-render-v2-shadow"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
